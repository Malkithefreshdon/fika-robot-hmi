# 'mock' simulates the Python supervisory controller in-browser (default, no backend needed).
# 'live' connects to the real supervisor over WebSocket — see app/services/backend/liveBackend.ts.
NUXT_PUBLIC_BACKEND_MODE=mock

# WebSocket URL of the Python supervisory controller (only used when backend mode is 'live').
NUXT_PUBLIC_BACKEND_WS_URL=ws://localhost:8765

# PIN used to enter the technician / dev-mode screens from the kiosk UI.
# NOT real security — just keeps customers from wandering into the tuning panel.
NUXT_PUBLIC_DEV_PIN=1234
